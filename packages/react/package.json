{
  "name": "@hadabridge/react",
  "version": "0.1.0",
  "description": "基于 React、Radix UI、CVA 与 Tailwind CSS 的组件库",
  "type": "module",
  "sideEffects": ["./styles.css"],
  "files": ["dist", "src", "styles.css", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./lib/cn": {
      "types": "./dist/lib/cn.d.ts",
      "import": "./dist/lib/cn.js",
      "default": "./dist/lib/cn.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint . --max-warnings 0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.hadawallet.com/dev/hadabridge-ui-monorepo.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "dependencies": {
    "@hadabridge/tokens": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0",
    "tailwindcss": ">=4.1.0 <5.0.0"
  },
  "devDependencies": {
    "@hadabridge/eslint-config": "workspace:*",
    "@hadabridge/typescript-config": "workspace:*",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
